{
  "name": "@flashyos/mesh-lint",
  "version": "0.1.0",
  "description": "A GitHub Action for the checks that fail silently.",
  "license": "Apache-2.0",
  "author": "Flashy Labs",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flashylabs/mesh-lint.git"
  },
  "homepage": "https://github.com/flashylabs/mesh-lint#readme",
  "bugs": "https://github.com/flashylabs/mesh-lint/issues",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "github-action",
    "linter",
    "ci",
    "json-schema",
    "supply-chain",
    "provenance",
    "well-known",
    "static-analysis"
  ],
  "bin": {
    "mesh-lint": "./src/cli.mjs"
  },
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test src/drift.test.mjs src/mesh-lint.test.mjs src/types.test.mjs"
  }
}
